# Copy this file to .env and fill in real values.
# Never commit .env. The server refuses to start if a required value is missing or unsafe.

# Port the API listens on.
PORT=5000

# "development" on your computer, "production" on Railway.
NODE_ENV=development

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/school-portal

# Secret used to sign access tokens.
# It must be at least 64 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server refuses to start while this placeholder is still here.
JWT_SECRET=replace_this_placeholder_with_your_own_random_secret_value

# Access token life in minutes. Must not be longer than IDLE_TIMEOUT_MINUTES.
ACCESS_TOKEN_MINUTES=10

# Refresh token life in days. The absolute session cap may end it sooner.
REFRESH_TOKEN_DAYS=7

# A user who makes no request for this many minutes is logged out by the server.
IDLE_TIMEOUT_MINUTES=10

# Hard cap for one login family, in hours.
SESSION_MAX_HOURS=24

# Optional cookie domain. Leave empty for host-only cookies.
# For a custom domain like app.example.com + api.example.com, use .example.com
COOKIE_DOMAIN=

# The exact frontend address allowed to call the API. Do not add a trailing slash.
FRONTEND_URL=http://localhost:5173

# Folder where uploaded ZIP files are stored.
UPLOAD_DIR=./uploads

# Optional: used by node seedAdmin.js. Never put a real password in git.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: used by node scripts/seedDemo.js for fake demo accounts.
SEED_DEMO_PASSWORD=
