# Copy this file to .env and fill in real values.
# Never commit .env. The server refuses to start if a required value is missing or unsafe.

# Port the API listens on.
PORT=5000

NODE_ENV=development

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/school-portal

# Secret used to sign access tokens.
# It must be at least 64 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server refuses to start while this placeholder is still here.
JWT_SECRET=replace_this_placeholder_with_your_own_random_secret_value

# Access token life in minutes. Must not be longer than IDLE_TIMEOUT_MINUTES.
ACCESS_TOKEN_MINUTES=10

# Refresh token life in days. The absolute session cap may end it sooner.
REFRESH_TOKEN_DAYS=7

# A user who makes no request for this many minutes is logged out by the server.
IDLE_TIMEOUT_MINUTES=10

# Hard cap for one login family, in hours.
SESSION_MAX_HOURS=24

# Set to false to disable Expo push delivery.
PUSH_ENABLED=true

# Mobile refresh token lifetime in days.
MOBILE_REFRESH_TOKEN_DAYS=30

# Mobile inactivity timeout in minutes.
MOBILE_IDLE_TIMEOUT_MINUTES=43200

# Mobile hard cap for one login family, in hours.
MOBILE_SESSION_MAX_HOURS=720

# Optional cookie domain. Leave empty for host-only cookies.
COOKIE_DOMAIN=

# The exact frontend address allowed to call the API. Do not add a trailing slash.
FRONTEND_URL=http://localhost:5173

# Folder where uploaded ZIP files are stored.
UPLOAD_DIR=./uploads

# Assignment resource attachments.
ASSIGNMENT_RESOURCE_DIR=./uploads/assignment-resources
MAX_ASSIGNMENT_RESOURCES=20
MAX_ASSIGNMENT_RESOURCE_MB=50
ALLOWED_RESOURCE_EXTENSIONS=.pdf,.doc,.docx,.txt,.zip
ALLOWED_RESOURCE_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,application/zip

# Optional: used by node seedAdmin.js. Never put a real password in git.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: used by node scripts/seedDemo.js for fake demo accounts.
SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------------
# AI feedback drafts (optional)
# Add ONLY your key below. Everything else is already filled in.
# Leave AI_API_KEY empty to switch the feature off.
# ---------------------------------------------------------------------
AI_API_KEY=
# Set to false to switch the feature off even when a key exists.
AI_ENABLED=true
# Any OpenAI-compatible service works. Groq is the free default.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Most characters of student code sent to the AI. Free tiers have small
# per-minute limits, so keep this small.
AI_MAX_INPUT_CHARS=8000

# ---------------------------------------------------------------------
# At-risk student detection
# Set ENABLED=true to run the scheduled job. Thresholds come entirely
# from these environment variables.
# ---------------------------------------------------------------------
AT_RISK_DETECTION_ENABLED=false
AT_RISK_ATTENDANCE_THRESHOLD=70
AT_RISK_MISSED_SUBMISSIONS=2
AT_RISK_SCHEDULE=0 0 * * *